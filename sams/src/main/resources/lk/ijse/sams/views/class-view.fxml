      <TextField fx:id="classEndTimeTxtFld" layoutX="142.0" layoutY="305.0" prefHeight="26.0" prefWidth="264.0" />
      <Button fx:id="createClassBtn" layoutX="527.0" layoutY="189.0" mnemonicParsing="false" onAction="#onClickCreateClassBtn" prefHeight="35.0" prefWidth="227.0" style="-fx-background-color: #1abc9c;" text="Create Class">
