          <TableColumn fx:id="classdateClm" prefWidth="75.0" text="Date" />
          <TableColumn fx:id="classSubjectClm" prefWidth="75.0" text="Subject" />
            <TableColumn fx:id="classLectureClm" prefWidth="75.0" text="Lecture" />
            <TableColumn fx:id="classStartTimeClm" prefWidth="75.0" text="Start Time" />
            <TableColumn fx:id="classEndTimeClm" prefWidth="75.0" text="End Time" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
