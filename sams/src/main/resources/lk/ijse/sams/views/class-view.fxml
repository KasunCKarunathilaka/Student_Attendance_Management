      </Label>
      <Label layoutX="41.0" layoutY="109.0" text="Course :">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="229.0" prefHeight="18.0" prefWidth="58.0" text="Date :">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="38.0" layoutY="187.0" text="Lecturer :">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="147.0" text="Subject :">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="309.0" prefHeight="20.0" prefWidth="83.0" text="End  Time : ">
         <font>
            <Font size="14.0" />
