<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" fx:id="classSchedule" prefHeight="753.0" prefWidth="853.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.sams.controller.ClassViewController">
   <children>
      <Label layoutX="44.0" layoutY="35.0" prefHeight="30.0" prefWidth="195.0" text="Class Schedule">
